[Unit]
Description=MagicBridge first-boot finalize, part 2 (MSD grow + unique EDID, post-boot)
# Run AFTER the system is fully up so the capture device exists and MSD can be
# resized online. This is intentionally NOT ordered before anything, so it can
# never block boot or WiFi provisioning — the worst case is a smaller MSD.
After=kvmd.service multi-user.target
Wants=kvmd.service
# Only after the main first-boot finished, and only once.
ConditionPathExists=/var/lib/magicbridge/.mb-firstboot-done
ConditionPathExists=!/var/lib/magicbridge/.mb-firstboot-late-done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/magicbridge/provision/mb-firstboot-late.sh
# NO timeout. This unit grows the MSD filesystem ONLINE, and on a large card
# (238 GB observed) resize2fs can run past any fixed cap on slow SD media. At 900s
# systemd sent SIGTERM mid-resize — killing resize2fs part-way through an ext4
# resize risks an inconsistent filesystem, and because the done-marker is written
# after the resize it re-ran (and re-killed) on every subsequent boot. Nothing is
# ordered after this unit (see the header comment), so an unbounded run cannot
# block boot, WiFi provisioning, or the KVM.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
